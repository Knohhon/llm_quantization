# Переменные окружения имеют приоритет над этими значениями.
LLAMA_BIN_DIR="${LLAMA_BIN_DIR:-$HOME/llama.cpp/build/bin}"
THREADS="${THREADS:-4}"
CONTEXT_SIZE="${CONTEXT_SIZE:-2048}"
PROMPT_TOKENS="${PROMPT_TOKENS:-512}"
GENERATION_TOKENS="${GENERATION_TOKENS:-128}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-256}"
REPETITIONS="${REPETITIONS:-3}"
SEED="${SEED:-42}"
QUANTS="${QUANTS:-F16 Q8_0 Q6_K Q4_K_M Q2_K}"
KV_CACHE_TYPE="${KV_CACHE_TYPE:-f16}"
LOAD_MODE="${LOAD_MODE:-mmap}"
PPL_CONTEXT_SIZE="${PPL_CONTEXT_SIZE:-512}"
PPL_CHUNKS="${PPL_CHUNKS:--1}"
